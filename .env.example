PORT=3000
MONGODB_URI=
MONGODB_DB=tabrikuz
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=
PUBLIC_URL=http://localhost:3000

# Hamyon: server-side credentials; never put these in public files.
# Use the same provider contract as Gift Factory's auto-pay.js.
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=
HAMYON_API_URL=
HAMYON_API_METHOD=POST
HAMYON_CREATE_URL=
# Optional fallback HTTPS checkout template with {invoice} and {amount}.
HAMYON_CHECKOUT_URL=
# At least 24 chars. Webhook only wakes server-side reconciliation.
HAMYON_WEBHOOK_SECRET=
